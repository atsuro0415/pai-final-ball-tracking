<?xml version="1.0"?>
<sdf version="1.6">
  <model name="red_ball">
    <link name="link">
      <gravity>false</gravity>
      <inertial><mass>0.2</mass><inertia><ixx>0.0008</ixx><iyy>0.0008</iyy><izz>0.0008</izz></inertia></inertial>
      <collision name="c"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
      <visual name="v"><geometry><sphere><radius>0.1</radius></sphere></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
    </link>
    <plugin name="ball_drive" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/ball</namespace></ros>
      <update_rate>50</update_rate>
      <publish_odom>false</publish_odom><publish_odom_tf>false</publish_odom_tf>
      <robot_base_frame>link</robot_base_frame>
    </plugin>
  </model>
</sdf>
